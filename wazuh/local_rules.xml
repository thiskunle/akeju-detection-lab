<group name="akeju,">
  <rule id="100100" level="12">
    <if_sid>5402</if_sid>
    <match>/etc/shadow</match>
    <description>Akeju lab: sudo used to access the password hash file</description>
    <mitre><id>T1003.008</id></mitre>
  </rule>

  <rule id="100101" level="10">
    <if_sid>5402</if_sid>
    <match>/etc/sudoers|visudo</match>
    <description>Akeju lab: sudo configuration accessed through sudo</description>
    <mitre><id>T1548.003</id></mitre>
  </rule>

  <rule id="100102" level="14">
    <if_sid>5902</if_sid>
    <match>UID=0,</match>
    <description>Akeju lab: new account created with root's user ID</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <rule id="100103" level="12">
    <if_sid>5402</if_sid>
    <regex type="pcre2">(curl|wget)\s.*\|\s*(ba)?sh</regex>
    <description>Akeju lab: downloaded script piped into a shell with sudo</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

  <rule id="100104" level="12">
    <if_sid>5712</if_sid>
    <description>Akeju lab: SSH password guessing</description>
    <mitre><id>T1110.001</id></mitre>
  </rule>
</group>
